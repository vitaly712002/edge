# Центральная карта сайтов сервера. По одному блоку на домен.
# Caddy сам выпускает и продлевает TLS-сертификаты Let's Encrypt.
#
# Реальный домен НЕ хранится здесь: он берётся из переменной {$BASE_DOMAIN}
# (задаётся в edge/.env, который не коммитится). Так конфиг универсален, а
# личный домен не попадает в git.
#
# Каждое приложение подключено к сети "web" и доступно здесь по своему alias.
# Приложения НЕ знают друг о друге — вся маршрутизация только тут.

# === chatkeeper ===
# Go-сервер отдаёт и веб-панель, и API на :8080 — проксируем целиком.
chatkeeper.{$BASE_DOMAIN} {
	reverse_proxy chatkeeper:8080
}

# === secure-ask: webhook-бот ===
ask-bot.{$BASE_DOMAIN} {
	reverse_proxy secure-ask-bot:8080
}

# === secure-ask: админка + API ===
# Бот сам отдаёт и /api, и статику панели (как chatkeeper) — проксируем целиком.
{$BASE_DOMAIN} {
	reverse_proxy secure-ask-bot:8080
}
